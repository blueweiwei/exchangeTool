# 统一换行符，避免跨平台问题：
# - Windows 脚本（.ps1/.bat/.cmd）保持 CRLF
# - 其余文本（含 .sh 与 CI 的 .yml）统一 LF
#   否则在 Linux Runner 上会因 CRLF 导致 bash 报 "syntax error near unexpected token"
* text=auto

*.ps1   text eol=crlf
*.bat   text eol=crlf
*.cmd   text eol=crlf

*.sh    text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.go    text eol=lf
*.json  text eol=lf
*.md    text eol=lf
*.html  text eol=lf
*.js    text eol=lf
*.css   text eol=lf

# 二进制文件不要做换行符转换
*.exe   binary
*.dll   binary
*.png   binary
*.jpg   binary
*.gif   binary
*.ico   binary
*.woff  binary
*.woff2 binary
